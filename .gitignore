# Dependencias de npm. package-lock.json SÍ se versiona: garantiza que la
# instalación del evaluador resuelva exactamente las mismas versiones.
node_modules/

# Salida del empaquetado
dist/

# Sistema operativo / editores
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp

# Python del generador del .docx
__pycache__/
*.pyc

# Logs y temporales
*.log
*.tmp

#CL
/.claude/

# Logo institucional extraido al vuelo por el generador del .docx
docs/iudigital_doc/*/generador/refmedia/
